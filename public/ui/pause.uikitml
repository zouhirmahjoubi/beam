<!--
  Shown when a controller becomes active: the game is hands-only.
-->
<style>
  .card {
    flex-direction: column;
    align-items: center;
    width: 344px;
    padding-top: 20px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .heading {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    color: #272727;
    text-align: center;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .body {
    margin-top: 10px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    color: #272727;
    text-align: center;
  }

  .body:dark {
    color: rgba(255, 255, 255, 0.9);
  }
</style>
<Panel class="card">
  <div class="heading">Paused</div>
  <div class="body">Palmlight is played with your hands. Put the controllers down and it carries on.</div>
</Panel>
